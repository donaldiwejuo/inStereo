# Copy to .env for local development: cp .env.example .env
# Matches the Postgres in ../docker-compose.yml.
DATABASE_URL=postgres://instereo:instereo@localhost:5432/instereo
PORT=3000

# Cloudflare R2 (chat media + photos). Optional locally: without these the
# /media/uploads endpoint answers 503.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=instereo-media
# MEDIA_PUBLIC_URL=https://media.instereo.app
